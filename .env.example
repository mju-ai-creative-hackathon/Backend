POSTGRES_DB=hackathon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Spring을 기본값과 다르게 실행할 때 사용하는 값입니다.
DB_URL=jdbc:postgresql://localhost:5433/hackathon
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_SECONDS=3600
REFRESH_TOKEN_EXPIRATION_SECONDS=604800
GOOGLE_SERVER_CLIENT_ID=your-web-application-oauth-client-id

# Enable only after agreeing the AI API contract in docs/SHORTFORM_API.md.
SHORTFORM_STORAGE_ROOT=./data/shortforms
SHORTFORM_AI_ENABLED=false
SHORTFORM_AI_BASE_URL=
SHORTFORM_AI_API_KEY=
SHORTFORM_WORKER_ENABLED=true

# Experimental diary renderer. Keep remote until ready to switch modes.
SHORTFORM_RENDER_PROVIDER=remote
SHORTFORM_ENHANCED_EDITING_ENABLED=false
SHORTFORM_FFMPEG_PATH=ffmpeg
SHORTFORM_FFPROBE_PATH=ffprobe
SHORTFORM_OUTPUT_ROOT=./data/shortforms/renders
SHORTFORM_FONT_FILE=
