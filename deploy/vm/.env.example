# deploy/vm/.env로 복사한다. setup.sh가 비어 있는 비밀값을 무작위로 채운다. .env는 git에 올리지 않는다.
POSTGRES_DB=hackathon
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=
# 32바이트 이상 무작위 값. 바꾸면 로그인 토큰과 서명 URL이 모두 무효가 된다.
JWT_SECRET=

# NPM이 접근할 주소와 포트. 이 VM의 IP를 적으면 그 인터페이스에만 연다.
APP_BIND=0.0.0.0
APP_PORT=8080

GOOGLE_SERVER_CLIENT_ID=
GEMINI_API_KEY=
KAKAO_REST_API_KEY=
SEED_PLACES_ENABLED=true

# AI 영상 서버. 검토 화면이 있는 iOS 앱이 나온 뒤 true로 켠다.
SHORTFORM_AI_ENABLED=false
SHORTFORM_AI_BASE_URL=http://host.docker.internal:18000/api/v1
# LLM PC의 .env API_KEY와 같은 값
SHORTFORM_AI_API_KEY=
# LLM PC가 잠시 꺼지거나 터널이 끊겨도 바로 실패하지 않게 넉넉히 둔다.
SHORTFORM_MAX_FAILURES=20
SHORTFORM_DAILY_RENDER_LIMIT=5
